#!/usr/bin/env python3
"""Starts flux-tray from a checkout. Symlink this file into ~/.local/bin:
    ln -sf ~/projects/flux-tray/flux-tray ~/.local/bin/flux-tray
It resolves the link, so `git pull` is all an update needs."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from flux_tray.app import main  # noqa: E402

main()
