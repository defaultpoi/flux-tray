# PATTERN 4: Network/Thread Tests (with FakeSite, run_when_online, etc.)
# =============================================================================
class Test<Module>Network(unittest.TestCase):
    """Tests involving network I/O (use FakeSite from test_media.py pattern)."""

    def setUp(self):
        # If needed, set up FakeSite or other network fixtures
        pass

    def test_<network_function>_<scenario>(self):
        with mock.patch.object(rt.urllib.request, 'urlopen') as urlopen:
            # Configure mock response
            urlopen.return_value.__enter__.return_value.read.return_value = b'{"key": "value"}'

            result = rt.<network_function>()

            urlopen.assert_called_once_with(<expected_url>, timeout=<expected>)
            self.assertEqual(result, <expected>)


